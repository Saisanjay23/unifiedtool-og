# ─── Server ───
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ─── MongoDB ───
MONGO_URI=mongodb://localhost:27017
DB_PREFIX=unified_tool

# ─── YouTube API ───
YOUTUBE_API_KEY=

# ─── Telegram API ───
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ─── Scraping behavior ───
MAX_CONCURRENT_PROFILES=5
REQUEST_TIMEOUT_SEC=30

# ─── Security ───
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# ─── Paths ───
SESSION_PATH=sessions
CRON_JOBS_FILE=cron_jobs.json
