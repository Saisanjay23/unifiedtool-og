# Server
HOST=0.0.0.0
PORT=9000
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9000,http://127.0.0.1:9000

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_PREFIX=unified_tool

# Official platform APIs
YOUTUBE_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Browser and scraping behavior
MAX_CONCURRENT_PROFILES=3
MAX_CONCURRENT_JOBS=5
DEFAULT_HEADLESS=true
DEFAULT_MAX_RESULTS=50
REQUEST_TIMEOUT_SEC=30
PAGE_NAVIGATION_TIMEOUT_MS=60000
ELEMENT_WAIT_TIMEOUT_MS=15000
PROXY_URL=

# Analysis performance
ANALYSIS_CONCURRENT_TABS=3
ANALYSIS_INTER_PROFILE_DELAY=1.5
ANALYSIS_PAGE_TIMEOUT_MS=20000
ANALYSIS_SKIP_MOBILE_FALLBACK=true
ANALYSIS_API_CONCURRENT_TABS=6
ANALYSIS_API_INTER_PROFILE_DELAY=0

# Platform rate limits per hour
RATE_LIMIT_FACEBOOK=30
RATE_LIMIT_INSTAGRAM=60
RATE_LIMIT_TWITTER=40
RATE_LIMIT_YOUTUBE=100
RATE_LIMIT_TELEGRAM=80
RATE_LIMIT_TIKTOK=60

# Health thresholds
HEALTH_DEGRADED_THRESHOLD=0.7
HEALTH_CRITICAL_THRESHOLD=0.4
HEALTH_SUSPENSION_THRESHOLD=0.2

# Cron and runtime paths
CRON_ENABLED=false
CRON_JOBS_FILE=cron_jobs.json
SESSION_PATH=sessions
LOG_PATH=logs
